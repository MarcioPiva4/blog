# Banco (docker compose up -d db)
DATABASE_URL=postgres://blogs:blogs@localhost:5434/blogs

# Domínio raiz: cada blog vira <slug>.<ROOT_DOMAIN>. Em dev, *.localhost funciona no Chrome/Edge.
ROOT_DOMAIN=localhost
# Host do painel (sem porta)
ADMIN_HOST=painel.localhost
# Protocolo público dos blogs (http em dev, https em produção)
PUBLIC_PROTOCOL=http
# Porta pública em dev (deixe vazio em produção)
PUBLIC_PORT=3100

# Login do painel. Gere o hash com: npm run hash-password -- "sua-senha"
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD_HASH=
# Segredo da sessão (32+ caracteres aleatórios)
AUTH_SECRET=

# Proteção dos endpoints /api/cron/* (Coolify chama com Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Pasta de imagens enviadas
MEDIA_DIR=./media

# IndexNow (qualquer string hex de 32 caracteres); vazio = desligado
INDEXNOW_KEY=
